{
  "name": "scancode",
  "version": "2.0.4",
  "description": "ScanCode v2.0.4 camera regression fix restoring the proven ZXing direct webcam pipeline from v1.3 while retaining warehouse evidence, BigSeller bridge, server sync, QA and diagnostics.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:setup": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@zxing/browser": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.johnmarkbataller.scancode",
    "productName": "ScanCode",
    "files": [
      "main.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "executableName": "ScanCode",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "ScanCode-Portable-${version}-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScanCode",
      "uninstallDisplayName": "ScanCode \u2014 John Mark Bataller",
      "artifactName": "ScanCode-Setup-${version}-${arch}.${ext}"
    },
    "copyright": "Copyright \u00a9 2026 John Mark Bataller",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "extraMetadata": {
      "author": "John Mark Bataller"
    }
  },
  "author": "John Mark Bataller"
}
