{
  "name": "scancode",
  "version": "3.0.0",
  "description": "ScanCode v3 stable runtime rebuild with pinned Electron/ZXing versions, runtime webcam smoke testing, parcel recording, evidence capture, server sync and BigSeller bridge.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:setup": "electron-builder --win nsis --publish never",
    "smoke": "electron . --smoke-test"
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.22.0"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.johnmarkbataller.scancode",
    "productName": "ScanCode",
    "files": [
      "main.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "executableName": "ScanCode",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "ScanCode-Portable-${version}-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScanCode",
      "uninstallDisplayName": "ScanCode \u2014 John Mark Bataller",
      "artifactName": "ScanCode-Setup-${version}-${arch}.${ext}"
    },
    "copyright": "Copyright \u00a9 2026 John Mark Bataller",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "extraMetadata": {
      "author": "John Mark Bataller"
    }
  },
  "author": "John Mark Bataller"
}
